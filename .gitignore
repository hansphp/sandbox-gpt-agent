# Local environment and secrets
.env
.env.*
!.env.example
*.token
*.secret
secrets/

# Runtime state and logs
*.log
logs/
tmp/
temp/
*.pid
*.sock

# Generated archives and release bundles
*.tar
*.tar.gz
*.tgz
*.zip

# Editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
